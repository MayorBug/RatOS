#!/usr/bin/env bash
# install ratos wifi hotspot on cb1
# GPL V3
########

# Error handling
set -xe

source /common.sh
install_cleanup_trap

echo_green "Install RatOS hotspot manager dependencies..."
# dnsmasq/iproute2/hostapd are required for NetworkManager's shared connections (hotspot)
check_install_pkgs network-manager dnsmasq hostapd iproute2 iw wireless-regdb
# NetworkManager ships dnsmasq.service enabled by default; keep it disabled so NM can spawn its own instance.
for unit in dnsmasq.service dnsmasq; do
    systemctl_if_exists stop "${unit}" || true
    systemctl_if_exists disable "${unit}" || true
    systemctl_if_exists mask "${unit}" || true
done

echo_green "Installing RatOS hotspot manager files..."
unpack /filesystem/root /

chmod +x /usr/lib/ratos/hotspot-manager.sh
chmod +x /etc/NetworkManager/dispatcher.d/90-ratos-hotspot

# provide a default /boot/hotspot.cfg if the user has not customized one yet
if [[ ! -f /boot/hotspot.cfg ]]; then
    install -D -m 600 /usr/share/ratos/hotspot.cfg /boot/hotspot.cfg
fi

# make sure systemd sees the freshly installed units before enabling them
systemctl daemon-reload || true

# Old create_ap installations are no longer used; remove leftovers if they exist
rm -rf "/home/${BASE_USER}/create_ap" || true
systemctl_if_exists disable create_ap.service || true
systemctl_if_exists stop create_ap.service || true

systemctl_if_exists enable hotspot-manager.service
systemctl_if_exists enable hotspot-manager.path

# Run an initial sync so new images boot with the correct NM state pre-configured
/usr/lib/ratos/hotspot-manager.sh apply || true

echo_green "Installing RatOS hotspot manager ... DONE!"
